<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/not_resolved"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:visibility="visible"
        android:weightSum="2"
        tools:ignore="MissingConstraints">

        <FrameLayout
            android:id="@+id/frameSpinner"
            android:layout_width="156dp"
            android:layout_height="wrap_content"
            android:layout_gravity="left|center_vertical"
            android:layout_weight="1.5">

            <TextView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center|right"
                android:background="@mipmap/ic_arrow_drop_down_black_24dp"
                android:visibility="gone" />

            <Spinner
                android:id="@+id/changeStatus"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_alignParentLeft="true"
                android:popupBackground="@color/white" />
        </FrameLayout>

        <TextView
            android:id="@+id/commentedCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/horizontal_vertical_spacing"
            android:layout_weight="0.25"
            android:drawableStart="@mipmap/round_comment_white_36"
            android:drawableTint="@color/secondary"
            android:fontFamily="@font/roboto_bold"
            android:gravity="center"
            android:maxLines="1"
            android:padding="@dimen/horizontal_vertical_spacing"
            android:text="6700"
            android:textColor="@color/secondary"
            android:textSize="@dimen/textSize16dp" />

        <ImageView
            android:id="@+id/ic_directions"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/horizontal_vertical_spacing"
            android:layout_marginEnd="@dimen/horizontal_vertical_spacing"
            android:layout_weight="0.25"
            android:padding="@dimen/horizontal_vertical_spacing"
            android:scaleType="fitCenter"
            android:src="@mipmap/ic_directions_white_24dp"
            android:tint="@color/secondary" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>