<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/tools"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    app:ignore="NamespaceTypo">

    <RelativeLayout xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/comment_parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        tools:ignore="MissingConstraints">

        <RelativeLayout
            android:id="@+id/relativeLayout1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/userImage"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@mipmap/ic_launcher"
                app:civ_border_color="@color/gray_closed"
                app:civ_border_width="0.2dp" />

            <TextView
                android:id="@+id/userName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/horizontal_vertical_spacing"
                android:layout_marginTop="@dimen/horizontal_vertical_spacing"
                android:layout_toLeftOf="@+id/postedOn"
                android:layout_toEndOf="@+id/userImage"
                android:layout_toRightOf="@+id/userImage"
                android:fontFamily="@font/roboto_bold"
                android:text="SBM Engineer"
                android:textColor="@color/primerColorBlack"
                android:textSize="@dimen/textSize16dp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/description_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/userName"
                android:layout_alignLeft="@+id/userName"
                android:layout_marginTop="@dimen/horizontal_vertical_spacing"
                android:fontFamily="@font/roboto_regular"
                android:gravity="left"
                android:text="102 complaints posted"
                android:textColor="@color/primerColorBlack"
                android:textSize="@dimen/textSize16dp"
                android:visibility="visible" />

            <TextView
                android:id="@+id/postedOn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/description_count"
                android:layout_alignLeft="@+id/description_count"
                android:layout_marginTop="@dimen/margin16dp"
                android:drawablePadding="4dp"
                android:fontFamily="@font/roboto_regular"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:text="2 hours ago"
                android:textColor="@color/secondary_text_color"
                android:textSize="@dimen/textSize14dp" />


        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@+id/relativeLayout1"
            android:layout_marginStart="88dp"
            android:background="@color/view_color" />

    </RelativeLayout>
</RelativeLayout>