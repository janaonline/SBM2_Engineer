<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:card_view="http://schemas.android.com/tools"
    android:id="@+id/parentLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/complaint_id_bgcolor">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primaryDark"
        android:minHeight="?attr/actionBarSize"
        android:theme="@style/ToolbarTheme" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomLayout"
        android:layout_below="@+id/toolbar">

        <include
            layout="@layout/recyclerview_for_comments"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/bottomLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:id="@+id/cvimagePreview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_above="@+id/postComm"
                android:layout_margin="@dimen/margin16dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/secondaryDark"
                app:cardCornerRadius="@dimen/horizontal_vertical_spacing"
                card_view:cardElevation="@dimen/horizontal_vertical_spacing"
                card_view:cardPreventCornerOverlap="false"
                card_view:cardUseCompatPadding="false">

                <FrameLayout
                    android:id="@+id/imagePreviewFrameLayout"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:gravity="bottom"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/imageToUpload"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerInside"
                        android:src="@mipmap/ic_add_a_photo_white_48dp" />

                    <ImageView
                        android:id="@+id/clear"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:background="@drawable/black_round_bg"
                        android:padding="4dp"
                        android:scaleType="fitCenter"
                        android:src="@mipmap/clear"
                        android:visibility="gone"
                        app:tint="@color/white" />
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <RelativeLayout
                android:id="@+id/postComm"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_alignParentBottom="true"
                android:background="@color/white">

                <View
                    android:id="@+id/view1"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/view_color" />

                <ImageView
                    android:id="@+id/addImage"
                    android:layout_width="48dp"
                    android:layout_height="match_parent"
                    android:padding="@dimen/horizontal_vertical_spacing"
                    android:scaleType="fitCenter"
                    android:src="@mipmap/ic_add_image"
                    app:tint="@color/primaryDark" />

                <EditText
                    android:id="@+id/textComment"
                    style="@style/EditTextTheme"
                    android:layout_height="match_parent"
                    android:layout_margin="@dimen/horizontal_vertical_spacing"
                    android:layout_toStartOf="@+id/send"
                    android:layout_toEndOf="@+id/addImage"
                    android:background="@color/transparent"
                    android:cursorVisible="true"
                    android:gravity="top"
                    android:hint="@string/write_a_comment"
                    android:imeOptions="actionDone"
                    android:inputType="text"
                    android:textColor="@color/primerColorBlack"
                    android:textColorHint="@color/secondary_text_color"
                    android:textSize="@dimen/textSize16dp" />

                <ImageView
                    android:id="@+id/send"
                    android:layout_width="48dp"
                    android:layout_height="match_parent"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@color/transparent"
                    android:padding="@dimen/horizontal_vertical_spacing"
                    android:scaleType="fitCenter"
                    android:src="@mipmap/ic_send_black_24dp"
                    app:tint="@color/primaryDark" />
            </RelativeLayout>
        </LinearLayout>
    </RelativeLayout>


</RelativeLayout>
