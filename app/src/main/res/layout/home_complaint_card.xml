<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="16dip"
    android:orientation="vertical">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stateListAnimator="@anim/lift_on_touch"
        app:cardCornerRadius="15dp"
        card_view:cardElevation="@dimen/horizontal_vertical_spacing"
        card_view:cardPreventCornerOverlap="false"
        card_view:cardUseCompatPadding="true">

        <RelativeLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:descendantFocusability="blocksDescendants"
            android:gravity="center"
            android:orientation="vertical">

            <RelativeLayout
                android:id="@+id/rl_top_feed"
                android:layout_width="fill_parent"
                android:layout_height="40dp"
                android:layout_marginBottom="0dp"
                android:background="#f5f6f8"
                android:orientation="vertical"
                android:paddingBottom="5dp">

                <ImageView
                    android:id="@+id/feed_flag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/margin20dp"
                    android:layout_marginTop="@dimen/horizontal_vertical_spacing"
                    android:gravity="center_vertical"
                    android:singleLine="true"
                    android:src="@mipmap/ic_flag_white_24dp"
                    android:textColor="#0a80f4"
                    android:textSize="14dp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_feed_user_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="16dp"
                    android:layout_toRightOf="@+id/feed_flag"
                    android:gravity="center_vertical"
                    android:singleLine="true"
                    android:text="Jagadeesh"
                    android:textColor="#0a80f4"
                    android:textSize="14dp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_feed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="2dp"
                    android:layout_toRightOf="@+id/tv_feed_user_name"
                    android:ellipsize="marquee"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:singleLine="true"
                    android:text="posted a complaint"
                    android:textColor="@color/black"
                    android:textSize="14dp" />
            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_below="@+id/rl_top_feed"
                android:background="#e6e6e6" />

            <RelativeLayout
                android:id="@+id/rl_top_cc"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rl_top_feed"
                android:layout_centerVertical="true"
                android:background="@color/white"
                android:gravity="center"
                android:orientation="vertical">

                <RelativeLayout
                    android:id="@+id/rl_cc_top"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin16dp"
                    android:layout_marginTop="@dimen/horizontal_vertical_spacing"
                    android:layout_marginEnd="@dimen/margin16dp"
                    android:layout_marginBottom="@dimen/horizontal_vertical_spacing"
                    android:orientation="horizontal">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/user_image"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_alignParentTop="true"
                        android:layout_centerVertical="true" />

                    <TextView
                        android:id="@+id/tv_username"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/horizontal_vertical_spacing"
                        android:layout_marginTop="@dimen/horizontal_vertical_spacing"
                        android:layout_toRightOf="@+id/user_image"
                        android:fontFamily="@font/roboto_bold"
                        android:maxLines="1"
                        android:text="Sudhakar Varma Dasari"
                        android:textColor="@color/primerColorBlack"
                        android:textSize="@dimen/textSize16dp"
                        android:textStyle="bold" />


                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/tv_username"
                        android:layout_alignLeft="@+id/tv_username"
                        android:scaleType="fitCenter">

                        <TextView
                            android:id="@+id/created_on"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentRight="true"
                            android:fontFamily="@font/roboto_regular"
                            android:maxLines="1"
                            android:text="2 hours ago"
                            android:textColor="@color/secondary_text_color"
                            android:textSize="@dimen/textSize14dp" />
                    </RelativeLayout>
                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/rl_cc_top">


                    <RelativeLayout
                        android:id="@+id/rl_cc_bottom"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        android:layout_marginLeft="18dp"
                        android:layout_marginRight="@dimen/horizontal_vertical_spacing"
                        android:layout_marginBottom="16dp">


                        <LinearLayout
                            android:id="@+id/categoryLL"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/horizontal_vertical_spacing"
                            android:layout_marginBottom="@dimen/horizontal_vertical_spacing"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/category_image"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:scaleType="fitCenter" />

                            <TextView
                                android:id="@+id/complaint_category"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_alignParentLeft="true"
                                android:layout_alignParentTop="true"
                                android:layout_gravity="bottom"
                                android:layout_marginStart="@dimen/horizontal_vertical_spacing"
                                android:fontFamily="@font/roboto_bold"
                                android:gravity="center_vertical"
                                android:maxLines="1"
                                android:singleLine="true"
                                android:text="Garbage Dump "
                                android:textColor="@color/secondaryDark"
                                android:textSize="@dimen/textSize16dp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/complaint_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/categoryLL"
                            android:layout_alignParentLeft="true"
                            android:layout_marginTop="@dimen/horizontal_vertical_spacing"
                            android:drawableLeft="@mipmap/round_check_circle_white_24"
                            android:drawablePadding="@dimen/horizontal_vertical_spacing"
                            android:drawableTint="@color/secondary"
                            android:fontFamily="@font/roboto_regular"
                            android:text="Status : Open"
                            android:textAllCaps="false"
                            android:textColor="@color/secondary"
                            android:textSize="@dimen/textSize16dp" />

                        <TextView
                            android:id="@+id/complaint_location"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/complaint_status"
                            android:layout_gravity="bottom"
                            android:layout_marginTop="@dimen/horizontal_vertical_spacing"
                            android:layout_marginBottom="@dimen/horizontal_vertical_spacing"
                            android:drawableLeft="@mipmap/baseline_room_white_24"
                            android:drawablePadding="@dimen/horizontal_vertical_spacing"
                            android:drawableTint="@color/secondary"
                            android:ellipsize="end"
                            android:gravity="center_vertical"
                            android:maxLines="1"
                            android:text="Outer Ring Rd, Dollar scheme colony, Stage1, BTM Layout, Bengaluru"
                            android:textColor="@color/secondary"
                            android:textSize="@dimen/textSize16dp" />

                        <TextView
                            android:id="@+id/moreInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/complaint_location"
                            android:layout_gravity="bottom"
                            android:autoLink="all"
                            android:drawableLeft="@mipmap/round_info_white_36"
                            android:drawablePadding="@dimen/horizontal_vertical_spacing"
                            android:drawableTint="@color/secondary"
                            android:ellipsize="end"
                            android:gravity="center_vertical"
                            android:lineSpacingMultiplier="1.2"
                            android:maxLines="2"
                            android:text="@string/landmark"
                            android:textColor="@color/secondary"
                            android:textSize="@dimen/textSize16dp" />

                        <RelativeLayout
                            android:id="@+id/rl_cc_images"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/moreInfo"
                            android:layout_alignParentStart="true"
                            android:layout_marginStart="@dimen/horizontal_vertical_spacing"
                            android:layout_marginTop="@dimen/horizontal_vertical_spacing">

                            <androidx.cardview.widget.CardView
                                android:id="@+id/cv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/margin16dp"
                                android:layout_marginTop="@dimen/horizontal_vertical_spacing"
                                app:cardBackgroundColor="@color/secondary"
                                app:cardCornerRadius="15dp"
                                card_view:cardElevation="@dimen/horizontal_vertical_spacing">


                                <com.android.volley.toolbox.NetworkImageView
                                    android:id="@+id/complaint_image"
                                    android:layout_width="90dp"
                                    android:layout_height="90dp"
                                    android:scaleType="centerCrop" />

                            </androidx.cardview.widget.CardView>


                        </RelativeLayout>

                    </RelativeLayout>

                    <View
                        android:id="@+id/view"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_below="@+id/rl_cc_bottom"
                        android:layout_marginStart="@dimen/horizontal_vertical_spacing"
                        android:layout_marginEnd="@dimen/horizontal_vertical_spacing"
                        android:background="#e6e6e6" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/view"
                        android:layout_margin="8dp"
                        android:orientation="horizontal"
                        android:paddingTop="@dimen/horizontal_vertical_spacing"
                        android:paddingBottom="@dimen/horizontal_vertical_spacing">


                        <LinearLayout
                            android:id="@+id/not_resolved"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:visibility="visible"
                            android:weightSum="4">

                            <FrameLayout
                                android:id="@+id/frameSpinner"
                                android:layout_width="156dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1">

                                <TextView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_gravity="center|right"
                                    android:background="@mipmap/ic_arrow_drop_down_black_24dp"
                                    android:visibility="gone" />

                                <Spinner
                                    android:id="@+id/changeStatus"
                                    android:layout_width="match_parent"
                                    android:layout_height="52dp"
                                    android:layout_alignParentLeft="true"
                                    android:popupBackground="@color/white" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/votedUpCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:drawableStart="@mipmap/outline_thumb_up_white_36_before_voteup"
                                android:drawableTint="@color/secondary"
                                android:fontFamily="@font/roboto_bold"
                                android:gravity="center"
                                android:maxLines="1"
                                android:padding="@dimen/horizontal_vertical_spacing"
                                android:text="4500"
                                android:textColor="@color/secondary"
                                android:textSize="@dimen/textSize16dp" />

                            <TextView
                                android:id="@+id/commentedCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_weight="1"
                                android:drawableStart="@mipmap/round_comment_white_36"
                                android:drawableTint="@color/secondary"
                                android:fontFamily="@font/roboto_bold"
                                android:gravity="center"
                                android:maxLines="1"
                                android:padding="@dimen/horizontal_vertical_spacing"
                                android:text="6700"
                                android:textColor="@color/secondary"
                                android:textSize="@dimen/textSize16dp" />

                            <TextView
                                android:id="@+id/share"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:drawableLeft="@mipmap/round_share_white_36"
                                android:drawableTint="@color/secondary"
                                android:fontFamily="@font/roboto_bold"
                                android:gravity="center"
                                android:padding="@dimen/horizontal_vertical_spacing"
                                android:textColor="@color/secondary"
                                android:textSize="@dimen/textSize16dp" />

                        </LinearLayout>

                    </RelativeLayout>
                </RelativeLayout>
            </RelativeLayout>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>