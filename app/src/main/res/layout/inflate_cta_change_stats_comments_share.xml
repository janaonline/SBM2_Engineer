<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/not_resolved"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="visible"
        android:weightSum="4"
        tools:ignore="MissingConstraints">

        <FrameLayout
            android:id="@+id/frameSpinner"
            android:layout_width="156dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <TextView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center|right"
                android:background="@mipmap/ic_arrow_drop_down_black_24dp"
                android:visibility="gone" />

            <Spinner
                android:id="@+id/changeStatus"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_alignParentLeft="true"
                android:popupBackground="@color/white" />
        </FrameLayout>

        <TextView
            android:id="@+id/votedUpCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="false"
            android:drawableStart="@mipmap/outline_thumb_up_white_36_before_voteup"
            android:drawableTint="@color/secondary_text_color"
            android:enabled="false"
            android:fontFamily="@font/roboto_bold"
            android:gravity="center"
            android:maxLines="1"
            android:padding="@dimen/horizontal_vertical_spacing"
            android:text="4500"
            android:textColor="@color/secondary_text_color"
            android:textSize="@dimen/textSize16dp" />

        <TextView
            android:id="@+id/commentedCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:drawableStart="@mipmap/round_comment_white_36"
            android:drawableTint="@color/secondary"
            android:fontFamily="@font/roboto_bold"
            android:gravity="center"
            android:maxLines="1"
            android:padding="@dimen/horizontal_vertical_spacing"
            android:text="6700"
            android:textColor="@color/secondary"
            android:textSize="@dimen/textSize16dp" />

        <TextView
            android:id="@+id/share"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:drawableLeft="@mipmap/round_share_white_36"
            android:drawableTint="@color/secondary"
            android:fontFamily="@font/roboto_bold"
            android:gravity="center"
            android:padding="@dimen/horizontal_vertical_spacing"
            android:textColor="@color/secondary"
            android:textSize="@dimen/textSize16dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>