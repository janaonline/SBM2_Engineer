<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white">
  <RelativeLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal">

    <View
        android:id="@+id/view"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/view_color"
        android:layout_marginBottom="@dimen/horizontal_vertical_spacing" />

    <LinearLayout
        android:id="@+id/not_resolved"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_below="@+id/view"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="visible"
        android:weightSum="3">

      <TextView
          android:id="@+id/voted_up"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_weight="0.2"
          android:drawableLeft="@mipmap/outline_thumb_up_white_36_before_voteup"
          android:drawableTint="@color/secondary"
          android:fontFamily="@font/roboto_bold"
          android:gravity="center"
          android:maxLines="1"
          android:padding="@dimen/horizontal_vertical_spacing"
          android:text="45"
          android:textColor="@color/secondary"
          android:textSize="@dimen/textSize16dp" />

      <TextView
          android:id="@+id/comment"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="center"
          android:layout_marginStart="@dimen/margin16dp"
          android:layout_weight="0.2"
          android:drawableLeft="@mipmap/round_comment_white_36"
          android:drawableTint="@color/secondary"
          android:fontFamily="@font/roboto_bold"
          android:gravity="center"
          android:maxLines="1"
          android:padding="@dimen/horizontal_vertical_spacing"
          android:text="67"
          android:textColor="@color/secondary"
          android:textSize="@dimen/textSize16dp" />

      <TextView
          android:id="@+id/feedbackBtn"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="@dimen/margin16dp"
          android:drawableLeft="@mipmap/round_star_rate_white_24"
          android:drawableTint="@color/secondary"
          android:fontFamily="@font/roboto_bold"
          android:gravity="right|center_vertical"
          android:padding="@dimen/horizontal_vertical_spacing"
          android:visibility="gone"
          android:textColor="@color/secondary"
          android:textSize="@dimen/textSize16dp" />

      <TextView
          android:id="@+id/share"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="right"
          android:layout_weight="1.8"
          android:drawableRight="@mipmap/round_share_white_36"
          android:drawableTint="@color/secondary"
          android:fontFamily="@font/roboto_bold"
          android:gravity="right|center_vertical"
          android:padding="@dimen/horizontal_vertical_spacing"
          android:textColor="@color/secondary"
          android:textSize="@dimen/textSize16dp" />

    </LinearLayout>


  </RelativeLayout>
</RelativeLayout>