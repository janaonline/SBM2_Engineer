<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primaryDark</item>
        <item name="colorAccent">@color/primaryDark</item>

    </style>

    <style name="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowTranslucentStatus" tools:targetApi="kitkat">true</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />


    <style name="ToolbarTheme" parent="ThemeOverlay.AppCompat.Light">
        <item name="android:fontFamily" tools:ignore="NewApi">@font/montserrat_blackitalic</item>
    </style>

    <style name="TextViewTheme" parent="ThemeOverlay.AppCompat.Light">
        <item name="android:fontFamily" tools:ignore="NewApi">@font/montserrat_bold</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>

    </style>

    <style name="TextViewSecondaryTheme" parent="ThemeOverlay.AppCompat.Light">
        <item name="android:fontFamily" tools:ignore="NewApi">@font/adobe_clean_regular</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:textSize">@dimen/textSize17dp</item>
        <item name="android:paddingLeft">@dimen/activity_horizontal_margin</item>
        <item name="android:paddingRight">@dimen/activity_horizontal_margin</item>
        <item name="android:paddingTop">@dimen/horizontal_vertical_spacing</item>
        <item name="android:paddingBottom">@dimen/horizontal_vertical_spacing</item>

    </style>


    <style name="ButtonTheme" parent="Widget.AppCompat.Button">
        <item name="android:fontFamily" tools:ignore="NewApi">@font/montserrat_bold</item>
        <item name="android:background">@drawable/signup_with_fb_bg</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingLeft">@dimen/margin24dp
        </item>
        <item name="android:paddingRight">
            @dimen/margin24dp
        </item>
        <item name="android:textSize">@dimen/textSize16dp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:enabled">false</item>
        <item name="android:textColor">@color/greySecondary</item>
        <item name="android:layout_marginTop">@dimen/margin40dp</item>
        <item name="android:layout_marginBottom">@dimen/margin40dp</item>
        <item name="android:layout_centerHorizontal">true</item>
        <item name="android:layout_gravity">center_horizontal</item>
    </style>

    <style name="EditTextTheme" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/edittext_bg_</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart" tools:targetApi="jelly_bean_mr1">@dimen/margin16dp
        </item>
        <item name="android:layout_marginTop">@dimen/horizontal_vertical_spacing</item>
        <item name="fontFamily">@font/montserrat_bold</item>
        <item name="android:inputType">text|textAutoComplete|textAutoCorrect</item>
        <item name="android:maxLines">1</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:padding">@dimen/horizontal_vertical_spacing</item>
        <item name="android:textColor">@color/primerColorBlack</item>
        <item name="android:textSize">@dimen/textSize18dp</item>
    </style>

</resources>
