<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:card_view="http://schemas.android.com/tools"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:ignore="MissingConstraints">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/maintoolbar"
                    android:layout_width="match_parent"
                    android:layout_height="?android:attr/actionBarSize"
                    android:background="@color/primaryDark"
                    android:theme="@style/ToolbarTheme" />

                <ImageView
                    android:id="@+id/share"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="right"
                    android:layout_marginEnd="@dimen/horizontal_vertical_spacing"
                    android:padding="@dimen/horizontal_vertical_spacing"
                    android:src="@mipmap/round_share_white_36" />
            </FrameLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/cv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin16dp"
                app:cardBackgroundColor="@color/secondary"
                app:cardCornerRadius="15dp"
                card_view:cardElevation="@dimen/horizontal_vertical_spacing">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fitsSystemWindows="true">

                        <ImageView
                            android:id="@+id/complaint_image"
                            android:layout_width="match_parent"
                            android:layout_height="430dp"
                            android:scaleType="centerCrop" />

                        <ProgressBar
                            android:id="@+id/progressBarRim"
                            android:layout_width="@dimen/textSize32dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="bottom"
                            android:background="@drawable/gradient_shade">

                            <RelativeLayout
                                android:id="@+id/profileCategory"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_alignParentBottom="true"
                                android:layout_marginStart="@dimen/margin16dp"
                                android:layout_marginTop="@dimen/margin16dp"
                                android:layout_marginEnd="@dimen/margin16dp"
                                android:orientation="horizontal">

                                <de.hdodenhof.circleimageview.CircleImageView
                                    android:id="@+id/user_image"
                                    android:layout_width="56dp"
                                    android:layout_height="56dp"
                                    android:layout_alignParentTop="true"
                                    android:layout_centerVertical="true"
                                    app:civ_border_color="@color/gray_closed"
                                    app:civ_border_width="0.2dp" />

                                <TextView
                                    android:id="@+id/tv_username"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dip"
                                    android:layout_toEndOf="@+id/user_image"
                                    android:fontFamily="@font/roboto_bold"
                                    tools:text="Paul Walker"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/textSize16dp" />


                                <TextView
                                    android:id="@+id/hours_ago"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_below="@+id/tv_username"
                                    android:layout_alignStart="@+id/tv_username"
                                    android:layout_marginTop="@dimen/horizontal_vertical_spacing"
                                    android:fontFamily="@font/roboto_regular"
                                    android:maxLines="1"
                                    tools:text="2 hours ago"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/textSize14dp" />

                                <TextView
                                    android:id="@+id/complaint_category"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_below="@+id/user_image"
                                    android:layout_gravity="bottom"
                                    android:layout_marginTop="@dimen/margin16dp"
                                    android:layout_marginBottom="@dimen/horizontal_vertical_spacing"
                                    android:fontFamily="@font/roboto_bold"
                                    android:gravity="center_vertical"
                                    android:paddingBottom="@dimen/horizontal_vertical_spacing"
                                    tools:text="Urination in Public/Open Defecation"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/textSize16dp" />


                            </RelativeLayout>
                        </RelativeLayout>

                    </FrameLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                app:layout_behavior="@string/appbar_scrolling_view_behavior">


                <RelativeLayout
                    android:id="@+id/parentLayout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/white"
                    android:fitsSystemWindows="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">


                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <RelativeLayout
                                android:id="@+id/shadow"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:elevation="2dp">

                                <LinearLayout
                                    android:id="@+id/category_layout"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">


                                    <RelativeLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="16dp"
                                        android:layout_marginTop="@dimen/horizontal_vertical_spacing"
                                        android:layout_marginEnd="16dp">

                                        <TextView
                                            android:id="@+id/complaint_status"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_alignParentStart="true"
                                            android:layout_alignParentTop="true"
                                            android:drawablePadding="@dimen/horizontal_vertical_spacing"
                                            android:fontFamily="@font/roboto_regular"
                                            android:text="Status : Open"
                                            android:textAllCaps="false"
                                            android:textColor="@color/secondary"
                                            android:textSize="@dimen/textSize16dp"
                                            app:drawableStartCompat="@mipmap/round_check_circle_white_24"
                                            app:drawableTint="@color/secondary" />

                                        <TextView
                                            android:id="@+id/location"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_below="@+id/complaint_status"
                                            android:layout_gravity="bottom"
                                            android:layout_marginTop="@dimen/margin16dp"
                                            android:autoLink="all"
                                            android:drawablePadding="@dimen/horizontal_vertical_spacing"
                                            android:ellipsize="end"
                                            android:fontFamily="@font/roboto_regular"
                                            android:gravity="center_vertical"
                                            android:lineSpacingMultiplier="1.2"
                                            android:text="Dirty Smelly Unhygenic"
                                            android:textColor="@color/secondary"
                                            android:textIsSelectable="true"
                                            android:textSize="@dimen/textSize16dp"
                                            app:drawableStartCompat="@mipmap/baseline_room_white_24"
                                            app:drawableTint="@color/secondary" />


                                        <TextView
                                            android:id="@+id/moreInfo"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_below="@+id/location"
                                            android:layout_gravity="bottom"
                                            android:layout_marginTop="@dimen/margin16dp"
                                            android:autoLink="all"
                                            android:drawablePadding="@dimen/horizontal_vertical_spacing"
                                            android:ellipsize="end"
                                            android:fontFamily="@font/roboto_regular"
                                            android:gravity="center_vertical"
                                            android:lineSpacingMultiplier="1.2"
                                            android:text="Dirty Smelly Unhygenic"
                                            android:textColor="@color/secondary"
                                            android:textIsSelectable="true"
                                            android:textSize="@dimen/textSize16dp"
                                            app:drawableStartCompat="@mipmap/round_info_white_36"
                                            app:drawableTint="@color/secondary" />


                                        <RelativeLayout
                                            android:id="@+id/rl_top_feed"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_below="@+id/moreInfo"
                                            android:layout_marginStart="28dp"
                                            android:layout_marginTop="@dimen/margin16dp"
                                            android:orientation="vertical">

                                            <TextView
                                                android:id="@+id/tv_feed_user_name"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_centerVertical="true"
                                                android:layout_marginEnd="2dp"
                                                android:fontFamily="@font/roboto_bold"
                                                android:gravity="center_vertical"
                                                android:singleLine="true"
                                                android:text="@string/id_"
                                                android:textColor="@color/secondary_text_color"
                                                android:textSize="@dimen/textSize14dp" />

                                            <TextView
                                                android:id="@+id/tv_feed"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_centerVertical="true"
                                                android:layout_marginStart="2dp"
                                                android:layout_toEndOf="@+id/tv_feed_user_name"
                                                android:ellipsize="marquee"
                                                android:focusable="true"
                                                android:focusableInTouchMode="true"
                                                android:fontFamily="@font/roboto_bold"
                                                android:gravity="center_vertical"
                                                android:marqueeRepeatLimit="marquee_forever"
                                                android:singleLine="true"
                                                android:text="W02334C45475432"
                                                android:textColor="@color/secondary_text_color"
                                                android:textIsSelectable="true"
                                                android:textSize="@dimen/textSize14dp" />


                                        </RelativeLayout>

                                    </RelativeLayout>

                                    <TextView
                                        android:id="@+id/convertedtoEvent"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="@dimen/margin24dp"
                                        android:layout_marginTop="@dimen/horizontal_vertical_spacing"
                                        android:layout_marginBottom="@dimen/horizontal_vertical_spacing"
                                        android:background="@drawable/complaint_status_closed"
                                        android:fontFamily="@font/roboto_bold"
                                        android:gravity="center"
                                        android:text="Converted to Event"
                                        android:textColor="@color/secondaryDark"
                                        android:textSize="@dimen/textSize16dp"
                                        android:visibility="gone" />
                                </LinearLayout>


                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_below="@+id/category_layout"
                                    android:layout_marginStart="4dp"
                                    android:layout_marginTop="@dimen/horizontal_vertical_spacing"
                                    android:orientation="vertical">


                                    <FrameLayout
                                        android:id="@+id/locationMap"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/margin16dp"
                                        android:layout_marginBottom="@dimen/horizontal_vertical_spacing">

                                        <ImageView
                                            android:id="@+id/locationImage"
                                            android:layout_width="match_parent"
                                            android:layout_height="160dp"
                                            android:scaleType="centerCrop" />

                                        <ImageView
                                            android:id="@+id/directionsbtn"
                                            style="@style/Widget.AppCompat.Button"
                                            android:layout_width="48dp"
                                            android:layout_height="48dp"
                                            android:layout_gravity="bottom|right"
                                            android:layout_margin="18dp"
                                            android:background="@drawable/secondary_round_bg"
                                            android:padding="@dimen/horizontal_vertical_spacing"
                                            android:scaleType="fitCenter"
                                            android:src="@mipmap/baseline_directions_black_24"
                                            app:tint="@color/white" />
                                    </FrameLayout>

                                    <TextView
                                        android:id="@+id/complaintLocation"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="@dimen/margin16dp"
                                        android:layout_marginEnd="@dimen/margin16dp"
                                        android:layout_marginBottom="@dimen/margin16dp"
                                        android:fontFamily="@font/roboto_regular"
                                        android:text="Cunningham road, vasanth nagar, bengaluru, karnataka, india"
                                        android:textColor="@color/secondary_text_color"
                                        android:textSize="@dimen/textSize16dp" />


                                    <include
                                        layout="@layout/inflate_cta_change_stats_directions"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content" />
                                </LinearLayout>
                            </RelativeLayout>

                            <TextView
                                android:id="@+id/commentsText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_below="@+id/shadow"
                                android:layout_margin="@dimen/margin16dp"
                                android:text="@string/comments"
                                android:textColor="@color/secondaryDark"
                                android:textSize="@dimen/textSize16dp" />

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/mRecyclerviewComments"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_below="@+id/commentsText"
                                android:nestedScrollingEnabled="false"
                                card_view:targetApi="lollipop" />

                            <TextView
                                android:id="@+id/viewEmpty"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_below="@+id/commentsText"
                                android:layout_centerInParent="true"
                                android:layout_gravity="center"
                                android:layout_margin="32dp"
                                android:background="@color/transparent"
                                android:fontFamily="@font/roboto_bold"
                                android:gravity="center"
                                android:text="@string/be_the_first_to_comment"
                                android:textColor="@color/primerColorBlack"
                                android:textSize="@dimen/textSize16dp" />
                        </RelativeLayout>


                    </LinearLayout>

                </RelativeLayout>

            </LinearLayout>


        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>